# Supabase Configuration
# Replace these with your actual Supabase project URL and anon public key from Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Drive Folder Multi-Sheet Team Sync API
# Deploy the gas/TeamFolderAPI.gs script as a Web App (Access: Anyone) and paste the URL below:
VITE_GOOGLE_SHEETS_API_URL=https://script.google.com/macros/s/AKfycbx.../exec

